PORT=3000
DATABASE_URL=
DATABASE_SSL=true
CORS_ORIGIN=
PUBLIC_BASE_URL=https://xorazm-shevalari-backend-api.onrender.com
TRUST_PROXY=true

# Render Disk `/var/data` ga ulansa, audio yozuvlar deploylar orasida saqlanadi.
AUDIO_STORAGE_MODE=local
AUDIO_UPLOAD_DIR=/var/data/uploads

# Audio matnga aylantirish ixtiyoriy. Bo'sh qoldirilsa moderator tekshiradi.
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# Har ikkalasi uzun, turlicha va tasodifiy maxfiy kalit bo‘lishi kerak.
INTEGRATION_MASTER_KEY=
ADMIN_JWT_SECRET=

# Birinchi admin hisobini yaratish uchun, keyin `.env`dan olib tashlash mumkin.
OWNER_ADMIN_NAME=Loyiha egasi
OWNER_ADMIN_EMAIL=
OWNER_ADMIN_PASSWORD=

# --- Ilova yangilanishlari -------------------------------------------------
# CI reliz nashr qilish uchun mashinaviy token. Kamida 24 belgi.
# Yaratish:  openssl rand -base64 48
# Bo'sh bo'lsa reliz endpointi butunlay yopiq bo'ladi.
RELEASE_TOKEN=

# APK fayllari saqlanadigan katalog. Renderda doimiy diskda bo'lishi SHART,
# aks holda fayllar keyingi deployda yo'qoladi.
APK_UPLOAD_DIR=./var/apk

# Har bir ilova turi uchun diskda saqlanadigan reliz soni.
APK_RETENTION=5

# APK yuklab olish manzilining ochiq bazasi. Odatda Cloudflare Worker
# manzili — Render'ga to'g'ridan-to'g'ri ulanish O'zbekistondan sekin.
# Bo'sh bo'lsa PUBLIC_BASE_URL ishlatiladi.
PUBLIC_DOWNLOAD_BASE_URL=

# Firebase service account (xom JSON yoki base64). Bo'sh bo'lsa push
# o'chirilgan bo'ladi; yangilanish tizimi versiya so'rovi orqali baribir
# ishlaydi. Bu kalit HECH QACHON mobil ilovaga tushmaydi.
FIREBASE_SERVICE_ACCOUNT=
